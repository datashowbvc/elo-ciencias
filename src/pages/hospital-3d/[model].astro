---
import Layout from '../../layouts/BaseLayout.astro';
import {models} from '../../data/models.mjs';
import {href} from '../../utils/paths';
import '../../styles/models.css';
export function getStaticPaths(){return models.map(model=>({params:{model:model.key},props:{model}}));}
const {model}=Astro.props;
---
<Layout title={model.title} intro={model.subtitle} area="3d"><section class="wrap model-stage"><a class="back" href={href('hospital-3d/')}>← Selecionar outro ambiente</a><p class="kicker">Exploração 3D</p><h1>{model.title}</h1>{model.key==='hospital'?<><div id="hospital-viewer" data-model-url={href('models/hospital.glb')}><div class="viewport"><div id="hospital-canvas" role="region" aria-label="Modelo 3D: arraste para girar, use a roda para zoom e o botão direito para movimentar"></div><div class="viewer-overlay" aria-live="polite"><p id="model-status" role="status">Preparando visualização…</p><progress id="model-progress" aria-label="Carregamento do modelo"></progress><button id="model-retry" type="button" hidden>Tentar novamente</button></div></div><aside class="inspector"><h2>Inspeção das malhas</h2><p id="mesh-info" aria-live="polite">Selecione uma malha pelo modelo ou pela lista.</p><label for="mesh-list">Objetos técnicos</label><select id="mesh-list" size="7" aria-describedby="mesh-info" disabled><option value="">Aguardando modelo</option></select><button id="model-reset" type="button" disabled>Restaurar visão inicial</button><button id="model-clear" type="button" disabled>Limpar seleção</button><p class="help">Computador: arraste para girar; roda para zoom; botão direito para mover. Celular: um dedo gira; dois dedos aproximam e movem.</p><p class="help">Nomes técnicos não identificam setores clínicos. O contorno mostra apenas os limites da malha selecionada.</p><a href={href('models/hospital.glb')}>Abrir GLB original ↗</a></aside></div><noscript>Ative JavaScript para explorar o hospital.</noscript></>:<><div class="sketchfab-frame"><iframe id="external-model" title={model.subtitle} src={'https://sketchfab.com/models/'+model.uid+'/embed'} allow="autoplay; fullscreen; xr-spatial-tracking" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div><p id="external-status" role="status">Carregando visualizador externo do Sketchfab…</p><p class="model-fine">{model.subtitle} · {model.author}</p><a class="btn" href={model.source||''} target="_blank" rel="noopener noreferrer">Abrir no Sketchfab ↗</a><p class="model-fine">O acesso depende do Sketchfab, da conexão e das permissões do criador. Sem integração com serviços clínicos.</p></>}</section></Layout>
<script>
const root=document.getElementById('hospital-viewer');
if(root instanceof HTMLElement){import('../../features/hospital3d/viewer').then(({mountHospitalViewer})=>mountHospitalViewer(root)).catch(()=>{const s=document.getElementById('model-status');if(s)s.textContent='Não foi possível iniciar o visualizador. Use o link do GLB original.';});}
const frame=document.getElementById('external-model'),status=document.getElementById('external-status');
if(frame&&status){const timeout=setTimeout(()=>{status.textContent='Se o modelo não aparecer, tente abrir no Sketchfab. A disponibilidade depende do serviço externo.';},15000);frame.addEventListener('load',()=>{clearTimeout(timeout);status.textContent='Visualizador externo aberto. Se o modelo estiver indisponível, use Abrir no Sketchfab.';});frame.addEventListener('error',()=>{clearTimeout(timeout);status.textContent='Falha no visualizador externo. Use Abrir no Sketchfab.';});}
</script>
