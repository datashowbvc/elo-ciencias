---
import Layout from '../../layouts/BaseLayout.astro';
import ModelPreview from '../../components/ModelPreview.astro';
import {models} from '../../data/models.mjs';
import {href} from '../../utils/paths';
import '../../styles/models.css';
---
<Layout title="Maquete 3D" intro="Escolha um ambiente: hospital, sala de cirurgia ou recepção. Um visualizador por vez." area="3d"><section class="wrap model-gallery"><p class="kicker">Elo Ciências / Exploração espacial</p><h1>Três ambientes.<br/>Um novo olhar.</h1><p class="model-intro">Escolha um espaço para explorar em 3D.</p><div class="model-options">{models.map((model,i)=><a class="model-option panel" href={href('hospital-3d/'+model.key+'/')} data-reveal style={'--d:'+i*.08+'s'}><div class="model-preview" data-preview={model.uid||undefined}><ModelPreview kind={model.key}/>{model.uid&&<img hidden alt={'Pré-visualização oficial: '+model.subtitle} loading="lazy"/>}</div><span class="kicker">0{i+1}</span><h2>{model.title}</h2><p>{model.subtitle}</p><span class="btn btn--primary">Explorar →</span><small data-preview-label>{model.uid?'Prévia ilustrada; miniatura oficial quando disponível.':'Ilustração esquemática — não é captura do GLB.'}</small></a>)}</div><p class="model-fine">O hospital usa o GLB original. Os ambientes de cirurgia e recepção são modelos externos do Sketchfab e não representam setores confirmados da maquete.</p></section></Layout>
<script>import '../../features/models/previews.js';</script>
