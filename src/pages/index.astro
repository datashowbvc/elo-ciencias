---
import Layout from '../layouts/BaseLayout.astro';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import {href} from '../utils/paths';
import {sosPath,knowledge,challenges} from '../data/nav.js';
const people=['Ana Beatriz Cavalcanti','Débora Beatriz Martiniano de Melo Santos','Gabriel Lima Medeiros','Pedro Henrique de Melo','Rafael de Figueiredo Rocha','Sophia Camilli Ferreira Veloso','Tiago Matheus Francisco da Silva'];
const small=['de','da','do','das','dos'];
const initials=(name:string)=>{const w=name.split(' ').filter(x=>!small.includes(x));return (w[0][0]+w[w.length-1][0]).toUpperCase();};
const access=[{to:'hospital/',c:'#0f5e63',icon:'cross' as const,tag:'Saúde Conectada',title:'Acesso à simulação do hospital',line:'Sistema hospitalar demonstrativo.'},{to:sosPath,c:'#b91c1c',icon:'pulse' as const,tag:'SOS Saúde',title:'Acesso à simulação SOS Saúde',line:'Emergência no mapa do Recife.'},{to:'hospital-3d/',c:'#3f3d9b',icon:'cube' as const,tag:'Maquete 3D',title:'Acesso à maquete 3D do hospital',line:'Hospital, sala de cirurgia e recepção.'}];
---
<Layout title="Saúde pública e ciência: decisões que salvam vidas" intro="Elo Ciências — saúde pública e ciência: decisões que salvam vidas. Projeto do Colégio Elo, Recife, 2026.">
<section class="home-hero"><div class="wrap"><div><p class="eyebrow-2">Colégio Elo · Iniciação científica</p><h1 class="wordmark">Elo<span>Ciências</span></h1><p class="tagline">Saúde pública e ciência: decisões que salvam vidas.</p></div><Mark class="hero-mark" size={290} draw={true}/></div></section>
<div class="wrap"><div class="access-grid">{access.map((a,i)=><a class="access" href={href(a.to)} style={`--c:${a.c};--d:${i*0.09}s`} data-reveal><span class="ico"><Icon name={a.icon}/></span><span class="tag">{a.tag}</span><h2>{a.title}</h2><p>{a.line}</p><span class="go">Entrar <Icon name="arrow"/></span></a>)}</div></div>
<section class="sec"><div class="wrap team"><div data-reveal><p class="kicker">Equipe</p><h2 class="sec-title">Quem fez</h2><ul class="people">{people.map(p=><li><span class="ini">{initials(p)}</span><span>{p}</span></li>)}</ul></div><dl class="meta" data-reveal style="--d:.1s"><div><dt>Orientadores</dt><dd>Ivson, Luan, Nivaldo e Vitório</dd></div><div><dt>Instituição</dt><dd>Colégio Elo</dd></div><div><dt>Local e ano</dt><dd>Recife — 2026</dd></div></dl></div>
<div class="wrap"><p class="fineprint" data-reveal>Projeto de pesquisa sobre saúde pública e ciência apresentado ao programa de iniciação científica do Colégio Elo, como requisito parcial para obtenção da nota de A3 do III trimestre.</p></div></section>
<section class="sec"><div class="wrap" data-reveal><p class="kicker">Aprenda</p><h2 class="sec-title">Saúde pública em tópicos</h2><div class="chips">{knowledge.map(k=><a class="chip" href={href(k.path)}>{k.label}</a>)}</div><p class="chip-label">Desafios</p><div class="chips">{challenges.map(k=><a class="chip" href={href(k.path)}>{k.label}</a>)}</div></div></section>
</Layout>
