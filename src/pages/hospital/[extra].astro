---
import Layout from '../../layouts/BaseLayout.astro';
import AppointmentDemo from '../../components/AppointmentDemo.astro';
import HospitalSystem from '../../components/HospitalSystem.astro';
import '../../styles/hospital.css';
export function getStaticPaths(){return ['solicitacoes','exames','marcar-exames','resultados','localizacao','contato','agendamento','corpo-clinico'].map(kind=>({params:{extra:kind},props:{kind}}));}
const {kind}=Astro.props;
const titles:Record<string,string>={solicitacoes:'Ver solicitações',exames:'Ver exames','marcar-exames':'Marcar exames',resultados:'Ver resultados',localizacao:'Localização',contato:'Contato',agendamento:'Agendamento demonstrativo','corpo-clinico':'Equipe fictícia'};
const team=[['Helena Duarte','Cardiologia'],['Rafael Nunes','Pediatria'],['Marina Costa','Neurologia'],['Eduardo Freitas','Ortopedia'],['Camila Rocha','Clínica médica'],['Lucas Almeida','Dermatologia'],['Beatriz Lima','Ginecologia'],['André Ribeiro','Oftalmologia']];
---
<Layout title={titles[kind]} intro="Saúde Conectada — sistema hospitalar educativo com personagens e dados demonstrativos." hospital>{kind==='agendamento'?<section class="wrap hospital-system"><AppointmentDemo/></section>:kind==='corpo-clinico'?<section class="wrap hospital-system"><p class="kicker">Personagens do projeto</p><h1>Equipe fictícia</h1><div class="team-list">{team.map(([name,specialty])=><section class="team-person"><h2>{name}</h2><p>{specialty} · personagem fictício</p></section>)}</div></section>:<HospitalSystem kind={kind}/>}</Layout>
