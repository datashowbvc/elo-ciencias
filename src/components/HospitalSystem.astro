---
import {patients,exams,seed,statuses} from '../features/hospital/system.mjs';
import {href} from '../utils/paths';
interface Props{kind:string}
const {kind}=Astro.props;
const titles:Record<string,string>={solicitacoes:'Ver solicitações',exames:'Ver exames','marcar-exames':'Marcar exames',resultados:'Ver resultados',localizacao:'Localização',contato:'Contato'};
---
<section class="wrap hospital-system" data-hospital-system><p class="kicker">Saúde Conectada / Sistema demonstrativo</p><h1>{titles[kind]}</h1><p class="demo-context">Somente personagens e dados ilustrativos. Não informe dados pessoais reais.</p><p id="system-message" class="system-message" role="status" hidden></p>
{kind==='solicitacoes'?<><div class="hospital-toolbar"><label class="field">Status<select id="request-filter"><option value="">Todos</option>{Object.entries(statuses).map(([v,label])=><option value={v}>{label}</option>)}</select></label><a class="btn btn--primary" href={href('hospital/marcar-exames/')}>Nova solicitação</a><button id="restore" class="btn" type="button">Restaurar exemplos</button></div><div class="panel table-scroll"><table class="hospital-table"><caption>Solicitações demonstrativas desta aba</caption><thead><tr>{['Solicitação','Personagem','Exame','Data ilustrativa','Status','Ação'].map(h=><th scope="col">{h}</th>)}</tr></thead><tbody id="requests-body"/></table></div></>:kind==='exames'?<div class="exam-list">{exams.map(e=><section class="panel exam-item"><span class="badge badge--info">{e.area}</span><h2>{e.name}</h2><p>Exemplo do fluxo de solicitação. Sem preparo ou orientação clínica.</p><a class="btn btn--primary" href={href('hospital/marcar-exames/')}>Simular solicitação</a></section>)}</div>:kind==='marcar-exames'?<div class="panel booking-panel"><form id="exam-booking" class="hospital-form"><label class="field">Personagem<select name="patient" required><option value="">Selecione</option>{patients.map(p=><option value={p.id}>{p.name}</option>)}</select></label><label class="field">Exame ilustrativo<select name="exam" required><option value="">Selecione</option>{exams.map(e=><option value={e.id}>{e.name}</option>)}</select></label><label class="field">Data demonstrativa<input id="exam-date" name="date" type="date" required/></label><label class="field">Horário demonstrativo<select name="time" required><option value="">Selecione</option>{['09:00','10:30','14:00'].map(t=><option>{t}</option>)}</select></label><button class="btn btn--primary" type="submit">Registrar demonstração</button><button class="btn" type="reset">Limpar</button></form><a class="text-link" href={href('hospital/solicitacoes/')}>Ver solicitações →</a></div>:kind==='resultados'?<><div class="panel"><span class="badge badge--ok">Disponível · ilustrativo</span><h2>Radiografia — SC-1002</h2><p>Caio — personagem · Material educativo, sem imagem ou laudo clínico.</p><button class="btn btn--primary" data-result type="button">Abrir resultado ilustrativo</button></div><dialog id="result-dialog" class="result-dialog"><div class="drawer-head"><h2>Documento demonstrativo</h2><button id="close-result" class="icon-btn" type="button" aria-label="Fechar resultado">×</button></div><p>SC-1002 · Caio — personagem</p><p>Este documento representa apenas a disponibilização de um resultado no sistema. Não contém achados médicos, valores de referência ou diagnóstico.</p><span class="badge badge--info">Sem validade clínica</span></dialog></>:kind==='localizacao'?<div class="panel"><h2>Boa Viagem · Recife</h2><p>Posição virtual no mapa real: −8,1235; −34,9010. Não corresponde a um hospital ou endereço de atendimento existente.</p><div class="hospital-toolbar"><button id="load-location" class="btn btn--primary" type="button">Carregar mapa</button><a class="btn" href="https://www.openstreetmap.org/?mlat=-8.1235&mlon=-34.9010#map=15/-8.1235/-34.9010" target="_blank" rel="noopener noreferrer">Abrir mapa ↗</a></div><div id="location-map"/></div>:<div class="contact-grid"><div class="panel"><h2>Central demonstrativa</h2><p>atendimento@saudeconectada.example</p><p>Endereço de exemplo, sem envio de e-mail ou atendimento real.</p><form id="demo-contact" class="hospital-form"><label class="field">Assunto<select name="topic" required><option>Informação sobre o projeto</option><option>Como funciona a demonstração</option><option>Fontes e limites educativos</option></select></label><button class="btn btn--primary" type="submit">Gerar protocolo ilustrativo</button></form></div><div class="panel"><h2>Em uma emergência real</h2><p>O projeto não recebe pedidos de socorro e não aciona ambulâncias. No Brasil, o SAMU atende pelo 192.</p><a class="text-link" href="https://www.gov.br/saude/pt-br/composicao/saes/samu-192">Fonte: Ministério da Saúde ↗</a></div></div>}
<noscript>Ative JavaScript para executar o sistema demonstrativo.</noscript></section>
<script>import '../features/hospital/ui.js';</script>
