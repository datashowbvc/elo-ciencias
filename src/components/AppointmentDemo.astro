---
const specialties=['Cardiologia','Pediatria','Neurologia','Ortopedia','Clínica médica','Dermatologia','Ginecologia','Oftalmologia'];
---
<form class="sim-form" id="appointment-demo"><p class="eyebrow">Demonstração / Nenhum dado pessoal</p><h2>Experimente um agendamento.</h2><p>Esta atividade não reserva consultas, não envia dados e não presta atendimento.</p><label for="specialty">Especialidade</label><select id="specialty" name="specialty" required><option value="">Selecione</option>{specialties.map(s=><option>{s}</option>)}</select><label for="demo-doctor">Profissional fictício</label><select id="demo-doctor" name="doctor" required disabled><option value="">Escolha a especialidade primeiro</option></select><label for="demo-date">Data demonstrativa</label><input id="demo-date" type="date" name="date" required/><label for="demo-time">Horário demonstrativo</label><select id="demo-time" name="time" required><option value="">Selecione</option><option>09:00</option><option>10:30</option><option>14:00</option><option>15:30</option></select><button class="button" type="submit">Concluir simulação</button><button class="button secondary" type="reset">Reiniciar</button><output id="appointment-result" aria-live="polite" hidden></output><noscript>JavaScript é necessário para executar esta demonstração.</noscript></form>
<script>
const form=document.querySelector<HTMLFormElement>('#appointment-demo');
if(form){const specialty=form.querySelector<HTMLSelectElement>('#specialty')!,doctor=form.querySelector<HTMLSelectElement>('#demo-doctor')!,date=form.querySelector<HTMLInputElement>('#demo-date')!,result=form.querySelector<HTMLOutputElement>('#appointment-result')!;const doctors=['Helena Duarte','Rafael Nunes','Marina Costa','Eduardo Freitas','Camila Rocha','Lucas Almeida','Beatriz Lima','André Ribeiro'];const today=new Date();today.setMinutes(today.getMinutes()-today.getTimezoneOffset());date.min=today.toISOString().slice(0,10);specialty.addEventListener('change',()=>{doctor.replaceChildren();const option=document.createElement('option');option.textContent=specialty.value?(doctors[specialty.selectedIndex-1]+' — personagem fictício'):'Escolha a especialidade primeiro';option.value=specialty.value?doctors[specialty.selectedIndex-1]:'';doctor.append(option);doctor.disabled=!specialty.value;result.hidden=true;});form.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);result.hidden=false;result.textContent=`Simulação concluída: ${data.get('specialty')}, com ${data.get('doctor')} (personagem fictício), em ${data.get('date')} às ${data.get('time')}. Nenhuma consulta foi reservada e nenhum dado foi enviado.`;});form.addEventListener('reset',()=>{doctor.replaceChildren(new Option('Escolha a especialidade primeiro',''));doctor.disabled=true;result.hidden=true;result.textContent='';});}
</script>
