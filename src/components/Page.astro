---
import Layout from '../layouts/BaseLayout.astro';
import {href} from '../utils/paths';
import {pages,type Page} from '../data/pages';
interface Props {page:Page;}
const {page}=Astro.props;
const home=page.path===''||page.path==='hospital/';
const links=page.hospital?pages.filter(p=>p.hospital&&p.path!=='hospital/'):pages.filter(p=>['saude-publica/','ciencia/','sus/','prevencao/','vacinas/','desinformacao/'].includes(p.path));
---
<Layout title={page.title} intro={page.intro} hospital={page.hospital}><section class="hero"><div class:list={['shell',{'hero-grid':home}]}><div><p class="eyebrow">{page.hospital?'Saúde Conectada / Hospital virtual':'Elo Ciências / Saúde, ciência e sociedade'}</p>{page.planned&&<p class="status">Planejado · Ainda não disponível</p>}<h1>{page.title}</h1><p class="lead">{page.intro}</p>{home&&<div class="actions"><a class="button" href={href(page.hospital?'hospital/sobre/':'projeto/')}>{page.hospital?'Conheça o hospital':'Conhecer o projeto'} ↗</a><a class="button secondary" href={href(page.hospital?'hospital/especialidades/':'hospital/')}>{page.hospital?'Especialidades':'Entrar na Saúde Conectada'}</a></div>}</div>{home&&<aside class="editorial"><p class="eyebrow">Conhecer para cuidar</p><h2>{page.hospital?'Pessoas. Conhecimento. Cuidado.':'Como a ciência protege uma comunidade?'}</h2><p>{page.hospital?'Uma proposta fictícia para compreender a organização do cuidado.':'Da água tratada à vacinação, a saúde se constrói também fora dos hospitais.'}</p><a href={href(page.hospital?'hospital/estrutura/':'saude-publica/')}>Explore o tema →</a></aside>}</div></section>{page.path===''&&<div class="shell principles">{['Saúde é um direito.','Ciência transforma vidas.','Prevenção protege comunidades.','Informação salva vidas.'].map((text,i)=><div><span>0{i+1}</span>{text}</div>)}</div>}<div class="shell"><article>{page.sections.map(s=><section><h2>{s.title}</h2><p>{s.text}</p>{s.url&&<a href={s.url}>Consultar fonte oficial ↗</a>}</section>)}</article></div>{home&&<section class="section tint"><div class="shell"><p class="eyebrow">Explore o projeto</p><h2>{page.hospital?'Um cuidado, diferentes setores.':'Seis caminhos para aprender.'}</h2><div class="topics">{links.map((p,i)=><a class="topic" href={href(p.path)}><span>0{i+1}</span><div><h3>{p.title}</h3><p>{p.intro}</p></div><span aria-hidden="true">↗</span></a>)}</div></div></section>}</Layout>
