---
import Layout from '../layouts/BaseLayout.astro';
import {href} from '../utils/paths';
import {type Page} from '../data/pages';
interface Props {page:Page;}
const {page}=Astro.props;
const home=page.path==='hospital/';
const links=[{path:'hospital/estrutura/',title:'Estrutura hospitalar',intro:'Conheça a organização conceitual dos ambientes.'},{path:'hospital/corpo-clinico/',title:'Equipe fictícia',intro:'Personagens educativos, sem vínculos com profissionais reais.'},{path:'hospital-3d/',title:'Visualizador 3D',intro:'Explore o modelo original e suas malhas técnicas.'},{path:'hospital/simulacoes/',title:'Simulações interativas',intro:'Central de Emergências, triagem, vacinação e gestão.'},{path:'hospital/atividades/',title:'Atividades educativas',intro:'Reflita sobre escolhas e receba explicações.'}];
---
<Layout title={page.title} intro={page.intro} hospital={page.hospital}><section class="hero"><div class="shell"><p class="eyebrow">{page.hospital?'Saúde Conectada / Hospital fictício':'Elo Ciências / Conhecimento e sociedade'}</p>{page.planned&&<p class="status">Planejado · Ainda não disponível</p>}<h1>{page.title}</h1><p class="lead">{page.intro}</p>{home&&<div class="actions"><a class="button" href={href('hospital/simulacoes/emergencias/')}>Iniciar Central de Emergências ↗</a><a class="button secondary" href={href('hospital/sobre/')}>Sobre o hospital fictício</a></div>}</div></section><div class="shell"><article>{page.sections.map(s=><section><h2>{s.title}</h2><p>{s.text}</p>{s.url&&<a href={s.url}>Consultar fonte oficial ↗</a>}</section>)}</article>{home&&<section class="section"><p class="eyebrow">Explore por experiência</p><ol class="path-list">{links.map((p,i)=><li><a href={href(p.path)}><span>0{i+1}</span><div><h2>{p.title}</h2><p>{p.intro}</p></div><span aria-hidden="true">↗</span></a></li>)}</ol></section>}</div>{page.path==='vacinas/'&&<section class="shell section"><h2>Prevenção e cuidado coletivo</h2><p>A vacinação faz parte de um conjunto de ações de prevenção.</p><a href={href('prevencao/')}>Explorar prevenção no cotidiano →</a></section>}</Layout>
