---
import Layout from '../layouts/BaseLayout.astro';
import HospitalHome from './HospitalHome.astro';
import {href} from '../utils/paths';
import {type Page} from '../data/pages';
import '../styles/hospital.css';
interface Props {page:Page;}
const {page}=Astro.props;
const home=page.path==='hospital/';
---
<Layout title={home?'Saúde Conectada':page.title} intro={page.intro} hospital={page.hospital}>{home?<HospitalHome/>:<><section class="hero"><div class="shell"><p class="eyebrow">{page.hospital?'Saúde Conectada':'Elo Ciências / Conhecimento e sociedade'}</p>{page.planned&&<p class="status">Planejado · Ainda não disponível</p>}<h1>{page.title}</h1><p class="lead">{page.intro}</p></div></section><div class="shell"><article>{page.sections.map(s=><section><h2>{s.title}</h2><p>{s.text}</p>{s.url&&<a href={s.url}>Consultar fonte oficial ↗</a>}</section>)}</article></div>{page.path==='vacinas/'&&<section class="shell section"><h2>Prevenção e cuidado coletivo</h2><a href={href('prevencao/')}>Explorar prevenção no cotidiano →</a></section>}</>}</Layout>
