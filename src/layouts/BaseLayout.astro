---
import {href} from '../utils/paths';
import '../styles/global.css';
interface Props {title:string; intro:string; hospital?:boolean;}
const {title,intro,hospital=false}=Astro.props;
const links=hospital?[['hospital/','Inicio'],['hospital/sobre/','O hospital'],['hospital/especialidades/','Especialidades'],['hospital/servicos/','Servicos'],['hospital/estrutura/','Estrutura']]:[['','Inicio'],['projeto/','O projeto'],['saude-publica/','Saude publica'],['ciencia/','Ciencia'],['referencias/','Referências']];
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={intro}/><title>{title} | Elo Ciencias</title></head><body class:list={{hospital}}><a class="skip" href="#conteudo">Pular para o conteúdo</a><header><div class="shell header"><a class="brand" href={href(hospital?'hospital/':'')}>{hospital?'Hospital virtual':'Elo Ciências'}<small>{hospital?'Saúde Conectada · educativo':'Conhecer para cuidar'}</small></a><nav class="desktop" aria-label="Principal">{links.map(([path,label])=><a href={href(path)}>{label}</a>)}</nav><details class="mobile"><summary>Menu</summary><nav aria-label="Menu móvel">{links.map(([path,label])=><a href={href(path)}>{label}</a>)}<a href={href(hospital?'':'hospital/')}>{hospital?'Portal educativo':'Hospital virtual'}</a></nav></details><a class="switch" href={href(hospital?'':'hospital/')}>{hospital?'Portal educativo':'Hospital virtual'} ↗</a></div></header>{hospital&&<div class="notice">Instituição fictícia · Finalidade educativa · Sem atendimento real</div>}<main id="conteudo"><slot/></main><footer><div class="shell"><p class="eyebrow">Colégio Elo / Elo Ciências</p><h2>Conhecimento que<br/>aproxima e protege.</h2><nav aria-label="Rodapé"><a href={href('projeto/')}>O projeto</a><a href={href('referencias/')}>Referências</a><a href={href('hospital/')}>Hospital virtual</a><a href={href('hospital-3d/')}>Hospital 3D — planejado</a></nav><p class="fine">Saúde Conectada é fictícia. Sem atendimento, diagnóstico ou agendamento real. Projeto em desenvolvimento, ainda não publicado.</p></div></footer></body></html>
