---
import {href} from '../utils/paths';
import Mark from '../components/Mark.astro';
import {mainNav,hospitalNav,sosPath,knowledge} from '../data/nav.js';
import '../styles/global.css';
import '../styles/polish.css';
import '../styles/platform.css';
import '../styles/theme.css';
interface Props {title:string; intro:string; hospital?:boolean; area?:'elo'|'health'|'3d';}
const {title,intro,hospital=false,area}=Astro.props;
const zone=area??(hospital?'health':'elo');
const current=Astro.url.pathname.replace(/\/$/,'');
const on=(path:string)=>current===href(path).replace(/\/$/,'');
const themeColor=zone==='health'?'#0f5e63':zone==='3d'?'#3f3d9b':'#1e4a6b';
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={intro}/><meta name="theme-color" content={themeColor}/><title>{title} | Elo Ciências</title><script is:inline>document.documentElement.classList.add('js')</script></head><body class:list={['theme-'+zone]}><a class="skip" href="#conteudo">Pular para o conteúdo</a>
<header class="site-header"><div class="wrap bar"><a class="brand-link" href={href('')}><Mark/><span class="brand-name"><b>Elo Ciências</b><span>Saúde pública e ciência</span></span></a><nav class="nav-main" aria-label="Principal">{mainNav.map(i=><a class="nav-pill" href={href(i.path)} aria-current={zone===i.zone?'true':undefined}>{i.label}</a>)}</nav><button class="menu-btn" type="button" data-open-drawer aria-haspopup="dialog" aria-controls="drawer" aria-expanded="false">Menu</button></div></header>
<dialog id="drawer" class="drawer" aria-label="Menu"><div class="drawer-head"><b>Menu</b><button class="icon-btn" type="button" data-close-drawer aria-label="Fechar menu">×</button></div><nav class="drawer-nav" aria-label="Menu móvel">{mainNav.map(i=><a href={href(i.path)} aria-current={zone===i.zone?'true':undefined}>{i.label}</a>)}{hospitalNav.length>1&&<><h3>Saúde Conectada</h3>{hospitalNav.map(i=><a href={href(i.path)} aria-current={on(i.path)?'page':undefined}>{i.label}</a>)}<a href={href(sosPath)}>SOS Saúde</a></>}<h3>Conteúdo</h3>{knowledge.map(i=><a href={href(i.path)} aria-current={on(i.path)?'page':undefined}>{i.label}</a>)}</nav></dialog>
{zone==='health'&&hospitalNav.length>1&&<nav class="subnav" aria-label="Sistema hospitalar"><div class="wrap">{hospitalNav.map(i=><a class="sub-pill" href={href(i.path)} aria-current={on(i.path)?'page':undefined}>{i.label}</a>)}<a class="sub-sos" href={href(sosPath)}><i></i><span>SOS Saúde</span></a></div></nav>}
<main id="conteudo"><slot/></main>
<footer class="site-footer"><div class="wrap foot"><div class="foot-brand"><Mark size={38}/><div><b>ELO CIÊNCIAS</b><p>Colégio Elo · Recife — 2026</p></div></div><nav aria-label="Rodapé"><a href={href('referencias/')}>Fontes e referências</a><a href={href('saude-publica/')}>Saúde pública</a><a href={href('hospital/')}>Saúde Conectada</a><a href={href('hospital-3d/')}>Maquete 3D</a></nav></div><p class="wrap foot-note">Projeto educativo com dados demonstrativos. As simulações não oferecem atendimento, diagnóstico ou orientação clínica e não substituem o SAMU 192.</p></footer>
<script>import '../scripts/shell.js';</script></body></html>
