---
import {href} from '../utils/paths';
import '../styles/global.css';
import '../styles/polish.css';
import '../styles/platform.css';
interface Props {title:string; intro:string; hospital?:boolean;}
const {title,intro,hospital=false}=Astro.props;
const current=Astro.url.pathname.replace(/\/$/,'');
const active=(path:string)=>current===href(path).replace(/\/$/,'');
const links=hospital?[['hospital/','Apresentação'],['hospital/estrutura/','Estrutura'],['hospital/corpo-clinico/','Equipe'],['hospital-3d/','Visualizador 3D'],['hospital/simulacoes/','Simulações'],['hospital/atividades/','Atividades']]:[['','Início'],['saude-publica/','Saúde pública'],['ciencia/','Ciência e sociedade'],['sus/','SUS e acesso'],['vacinas/','Vacinação'],['desinformacao/','Desinformação'],['referencias/','Fontes']];
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={intro}/><meta name="theme-color" content={hospital?'#086575':'#0b2545'}/><title>{title} | Elo Ciências</title></head><body class:list={{hospital}}><a class="skip" href="#conteudo">Pular para o conteúdo</a><div class="shell area-tabs"><a href={href('')} aria-current={!hospital?'true':undefined}>Elo Ciências / Conhecimento</a><a href={href('hospital/')} aria-current={hospital?'true':undefined}>Saúde Conectada / Experiências</a></div><header><div class="shell header"><a class="brand" href={href(hospital?'hospital/':'')}>{hospital?'Saúde Conectada':'Elo Ciências'}<small>{hospital?'Hospital fictício · laboratório educativo':'Saúde pública, ciência e decisões'}</small></a><nav class="desktop" aria-label="Navegação da área">{links.map(([path,label])=><a href={href(path)} aria-current={active(path)?'page':undefined}>{label}</a>)}</nav><details class="mobile"><summary>Menu</summary><nav aria-label="Menu móvel">{links.map(([path,label])=><a href={href(path)} aria-current={active(path)?'page':undefined}>{label}</a>)}<a href={href(hospital?'':'hospital/')}>{hospital?'Ir para Elo Ciências':'Ir para Saúde Conectada'}</a></nav></details></div></header>{hospital&&<div class="notice">Experiências fictícias e educativas · Não presta atendimento médico real</div>}<main id="conteudo"><slot/></main><footer><div class="shell footer-layout"><div><p class="eyebrow">Elo Ciências / Colégio Elo</p><h2>Conhecer. Decidir. Aprender.</h2><p>Saúde pública e ciência: decisões que salvam vidas.</p></div><nav aria-label="Rodapé"><a href={href('projeto/')}>Sobre o projeto</a><a href={href('referencias/')}>Referências e fontes</a><a href={href('hospital/')}>Hospital fictício</a><a href={href('hospital/simulacoes/')}>Simulações educativas</a><a href={href('hospital-3d/')}>Visualizador 3D</a><a href={href('hospital/contato/')}>Contato e limites do projeto</a></nav></div><p class="shell fine">Nenhuma simulação oferece diagnóstico, atendimento, despacho ou agendamento real. Não usamos a localização do visitante nem solicitamos dados pessoais. Conteúdo educativo não substitui orientação profissional.</p></footer></body></html>
